{
  "manifest_version": 2,
  "name": "Trạm Truyện Sáng Tác Việt",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "stv-reader@tramtruyen.vn" } },
  "permissions": ["geckoViewAddons", "nativeMessaging", "nativeMessagingFromContent"],
  "content_scripts": [
    {
      "matches": ["https://sangtacviet.xyz/*", "https://sangtacviet.app/*", "https://sangtacviet.com/*", "https://sangtacviet.vip/*",
                  "https://www.sangtacviet.xyz/*", "https://www.sangtacviet.app/*", "https://www.sangtacviet.com/*", "https://www.sangtacviet.vip/*"],
      "js": ["sangtacviet_chapter.js", "chapter_bridge.js"],
      "run_at": "document_start"
    }
  ]
}
